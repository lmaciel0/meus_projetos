# Configurações do Leitor de Desligamentos CMIC

# Diretórios padrão
ENTRADA_PADRAO=./pdfs
SAIDA_PADRAO=./resultado

# OCR
USAR_OCR=true
LINGUA_OCR=por

# Logging
NIVEL_LOG=INFO

# Tesseract (Windows - ajuste se instalado em outro local)
# PYTESSERACT_PATH=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
